<?xml version="1.0" encoding="utf-8" ?>
<!--
    ملف الإعدادات العامة للتطبيق
    Kanban Project Management System
    =====================================
    
    يحتوي على الثوابت والإعدادات التي لا تتغير عادة.
    ملاحظة: هذا الملف لا يُخزِّن كلمات مرور أو سلاسل اتصال حساسة.
-->
<appSettings>
    
    <!-- ═══════════════════════════════════════════════ -->
    <!-- إعدادات التطبيق العامة                          -->
    <!-- ═══════════════════════════════════════════════ -->
    
    <!-- اسم التطبيق -->
    <add key="AppName" value="Kanban Project Management System" />
    
    <!-- إصدار التطبيق -->
    <add key="AppVersion" value="1.0.0" />
    
    <!-- اللغة الافتراضية -->
    <add key="DefaultLanguage" value="ar-SA" />
    
    <!-- دعم RTL -->
    <add key="RightToLeft" value="true" />
    
    
    <!-- ═══════════════════════════════════════════════ -->
    <!-- إعدادات الجلسة                                  -->
    <!-- ═══════════════════════════════════════════════ -->
    
    <!-- مدة الجلسة بالدقائق (0 = لا تنتهي) -->
    <add key="SessionTimeoutMinutes" value="120" />
    
    <!-- حفظ الجلسة عند إغلاق التطبيق -->
    <add key="RememberSession" value="false" />
    
    
    <!-- ═══════════════════════════════════════════════ -->
    <!-- إعدادات الأمان                                  -->
    <!-- ═══════════════════════════════════════════════ -->
    
    <!-- عدد دورات PBKDF2 لتشفير كلمات المرور -->
    <add key="PasswordHashIterations" value="10000" />
    
    <!-- الحد الأدنى لطول كلمة المرور -->
    <add key="MinimumPasswordLength" value="6" />
    
    <!-- عدد محاولات الدخول الفاشلة قبل تعطيل الحساب -->
    <add key="MaxLoginAttempts" value="5" />
    
    
    <!-- ═══════════════════════════════════════════════ -->
    <!-- إعدادات المهام                                  -->
    <!-- ═══════════════════════════════════════════════ -->
    
    <!-- الأولوية الافتراضية (1=High, 2=Medium, 3=Low) -->
    <add key="DefaultTaskPriority" value="2" />
    
    <!-- الحالة الافتراضية للمهمة الجديدة -->
    <add key="DefaultTaskStatus" value="New" />
    
    <!-- الحد الأقصى لعمق المهام الفرعية -->
    <add key="MaxTaskHierarchyDepth" value="5" />
    
    
    <!-- ═══════════════════════════════════════════════ -->
    <!-- إعدادات الواجهة                                 -->
    <!-- ═══════════════════════════════════════════════ -->
    
    <!-- حجم الخط الافتراضي -->
    <add key="DefaultFontSize" value="10" />
    
    <!-- اسم الخط -->
    <add key="DefaultFontFamily" value="Segoe UI" />
    
    <!-- عدد الصفوف لكل صفحة في التقارير -->
    <add key="ReportRowsPerPage" value="50" />
    
    <!-- عرض عمود البيانات -->
    <add key="DataGridRowHeight" value="40" />
    
    
    <!-- ═══════════════════════════════════════════════ -->
    <!-- إعدادات التسجيل (Logging)                       -->
    <!-- ═══════════════════════════════════════════════ -->
    
    <!-- تفعيل تسجيل الأخطاء -->
    <add key="EnableErrorLogging" value="true" />
    
    <!-- مسار ملف السجل -->
    <add key="LogFilePath" value="logs\app.log" />
    
    <!-- مستوى التسجيل (Debug/Info/Warning/Error) -->
    <add key="LogLevel" value="Info" />
    
</appSettings>